# Elechim — credenziali del container crawl4ai (quadlet podman, porta 11235).
# Copia questo file in `crawl4ai.env` accanto al quadlet prima di avviarlo.

# Token d'accesso all'API: il client (`web.py`) lo manda come header Bearer.
CRAWL4AI_API_TOKEN=inserisci-qui-un-token-a-caso

# Chiave segreta di crawl4ai per sessioni e firme interne.
SECRET_KEY=inserisci-qui-una-chiave-segreta

# Il server si lega a 127.0.0.1 DENTRO il container: crawl4ai resta
# raggiungibile solo dal loopback del fisso (forward sul 11235), mai dalla rete.
