# Elechim — variabili d'ambiente del Mac mini (modello + bot Telegram).
# Copia questo file in `.env` e riempi i segnaposto.
# `.env` contiene token veri ed e' escluso dal versionamento: mai committarlo.

# Il modello gira su QUESTA macchina: nessun tunnel di mezzo.
MAC_BASE_URL=http://127.0.0.1:8080

# Token del bot Telegram, lo rilascia @BotFather quando crei il bot.
TELEGRAM_TOKEN=inserisci-qui-il-token-di-@BotFather

# Nome del modello da usare per le risposte (quello caricato qui sul Mac).
MAC_MODEL=gemma-4-26b-a4b-it

# ID Telegram autorizzati a parlare col bot, separati da virgola.
TELEGRAM_ALLOWED_IDS=123456789,987654321

# Percorso del database SQLite che conserva lo stato delle conversazioni.
STATO_DB=stato.db

# URL del gateway strumenti sul fisso, raggiunto col forward inverso del tunnel.
GATEWAY_URL=http://127.0.0.1:8090
